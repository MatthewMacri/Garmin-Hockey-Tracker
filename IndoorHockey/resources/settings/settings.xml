<resources>
    <properties>
        <property id="periodCount"   type="number">3</property>
        <property id="periodMinutes" type="number">15</property>
        <property id="shiftSeconds"  type="number">60</property>
        <property id="shiftAlerts"   type="boolean">true</property>
        <property id="autoLap"       type="boolean">true</property>
        <property id="countDown"     type="boolean">true</property>
    </properties>

    <settings>
        <setting propertyKey="@Properties.periodCount" title="@Strings.SetPeriodCount" prompt="@Strings.SetPeriodCountPrompt">
            <settingConfig type="numeric" min="1" max="9" />
        </setting>
        <setting propertyKey="@Properties.periodMinutes" title="@Strings.SetPeriodMinutes" prompt="@Strings.SetPeriodMinutesPrompt">
            <settingConfig type="numeric" min="1" max="60" />
        </setting>
        <setting propertyKey="@Properties.shiftSeconds" title="@Strings.SetShiftSeconds" prompt="@Strings.SetShiftSecondsPrompt">
            <settingConfig type="numeric" min="15" max="600" />
        </setting>
        <setting propertyKey="@Properties.shiftAlerts" title="@Strings.SetShiftAlerts" prompt="@Strings.SetShiftAlertsPrompt">
            <settingConfig type="boolean" />
        </setting>
        <setting propertyKey="@Properties.autoLap" title="@Strings.SetAutoLap" prompt="@Strings.SetAutoLapPrompt">
            <settingConfig type="boolean" />
        </setting>
        <setting propertyKey="@Properties.countDown" title="@Strings.SetCountDown" prompt="@Strings.SetCountDownPrompt">
            <settingConfig type="boolean" />
        </setting>
    </settings>
</resources>
