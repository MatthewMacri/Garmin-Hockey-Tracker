<resources>
    <properties>
        <property id="shiftSeconds"  type="number">60</property>
        <property id="sensitivity"   type="number">1</property>
        <property id="shiftAlerts"   type="boolean">true</property>
        <!-- The buzz on every on-ice/bench change. Off: it reports what the
             player can see, and a 2026-11-09 report had it firing every ten
             seconds on the bench. -->
        <property id="changeAlerts"  type="boolean">false</property>
        <property id="autoLap"       type="boolean">true</property>
        <property id="useGps"        type="boolean">true</property>
        <property id="activityType"  type="number">0</property>
        <!-- Minutes off the ice before the game ends itself; 0 turns it off.
             The default has to be comfortably longer than an intermission,
             which is a normal 15 to 18 minutes of sitting down, or this would
             end live games - the exact bug 2.0.0 removed. -->
        <property id="endIdleMinutes" type="number">25</property>
        <!-- 0 means "do not estimate distance at all", which is the default
             and the honest setting. There is no published stride length for
             skating and no way to measure one from the wrist, so a number
             here is the player's claim, not the app's. -->
        <property id="strideLengthCm" type="number">0</property>
        <!-- 0 means "take it from the Garmin profile". That profile is very
             often 220-minus-age that nobody ever checked, and the app can
             only ever observe a maximum upwards - so without this there is no
             way to correct a profile that is too HIGH, and the 85% line sits
             above where it belongs for the rest of the player's life. -->
        <property id="maxHeartRate" type="number">0</property>
    </properties>

    <settings>
        <setting propertyKey="@Properties.shiftSeconds" title="@Strings.SetShiftSeconds" prompt="@Strings.SetShiftSecondsPrompt">
            <settingConfig type="numeric" min="15" max="600" />
        </setting>
        <setting propertyKey="@Properties.sensitivity" title="@Strings.SetSensitivity" prompt="@Strings.SetSensitivityPrompt">
            <settingConfig type="list">
                <listEntry value="0">@Strings.SensLow</listEntry>
                <listEntry value="1">@Strings.SensNormal</listEntry>
                <listEntry value="2">@Strings.SensHigh</listEntry>
            </settingConfig>
        </setting>
        <setting propertyKey="@Properties.shiftAlerts" title="@Strings.SetShiftAlerts" prompt="@Strings.SetShiftAlertsPrompt">
            <settingConfig type="boolean" />
        </setting>
        <setting propertyKey="@Properties.changeAlerts" title="@Strings.SetChangeAlerts" prompt="@Strings.SetChangeAlertsPrompt">
            <settingConfig type="boolean" />
        </setting>
        <setting propertyKey="@Properties.autoLap" title="@Strings.SetAutoLap" prompt="@Strings.SetAutoLapPrompt">
            <settingConfig type="boolean" />
        </setting>
        <setting propertyKey="@Properties.strideLengthCm" title="@Strings.SetStrideLength" prompt="@Strings.SetStrideLengthPrompt">
            <settingConfig type="numeric" min="0" max="500" />
        </setting>
        <setting propertyKey="@Properties.maxHeartRate" title="@Strings.SetMaxHr" prompt="@Strings.SetMaxHrPrompt">
            <settingConfig type="numeric" min="0" max="240" />
        </setting>
        <setting propertyKey="@Properties.useGps" title="@Strings.SetUseGps" prompt="@Strings.SetUseGpsPrompt">
            <settingConfig type="boolean" />
        </setting>
        <!-- min stays 0 because 0 is how the feature is turned off, and the
             numeric control cannot express "zero, or twenty and up". The real
             floor is END_IDLE_MIN_MINUTES in GameModel.loadSettings(), which
             raises anything from 1 to 19 up to 20. -->
        <setting propertyKey="@Properties.endIdleMinutes" title="@Strings.SetEndIdle" prompt="@Strings.SetEndIdlePrompt">
            <settingConfig type="numeric" min="0" max="180" />
        </setting>
        <setting propertyKey="@Properties.activityType" title="@Strings.SetActivityType" prompt="@Strings.SetActivityTypePrompt">
            <settingConfig type="list">
                <listEntry value="0">@Strings.TypeHockey</listEntry>
                <listEntry value="1">@Strings.TypeSkate</listEntry>
            </settingConfig>
        </setting>
    </settings>
</resources>
